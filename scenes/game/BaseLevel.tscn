[node name="BaseLevel" type="Node3D"]
script = ExtResource("1_base")

[node name="Player" parent="." instance=ExtResource("2_player")]
position = Vector3(0, 1, 0)

[node name="HUD" parent="." instance=ExtResource("3_hud")]

[node name="GameTimer" type="Node" parent="."]
script = ExtResource("4_timer")

[node name="TitleScreen" type="CanvasLayer" parent="."]
layer = 10

[node name="Background" type="ColorRect" parent="TitleScreen"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.04, 0.07, 0.04, 1)

[node name="StartLabel" type="Label" parent="TitleScreen"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -60.0
offset_right = 200.0
offset_bottom = 60.0
theme_override_font_sizes/font_size = 24
text = "READY?\n\nPress SPACE to begin"
horizontal_alignment = 1
vertical_alignment = 1

[node name="TransitionLayer" type="CanvasLayer" parent="."]
layer = 20

[node name="FadeRect" type="ColorRect" parent="TransitionLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0, 0, 0, 0)

[node name="PauseMenu" type="CanvasLayer" parent="."]
layer = 15
visible = false
script = ExtResource("5_pause")

[node name="Background" type="ColorRect" parent="PauseMenu"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0.02, 0, 0.88)

[node name="VBoxContainer" type="VBoxContainer" parent="PauseMenu"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -270.0
offset_right = 200.0
offset_bottom = 270.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="PausedLabel" type="Label" parent="PauseMenu/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.95, 0.75, 1)
theme_override_font_sizes/font_size = 36
text = "PAUSED"
horizontal_alignment = 1

[node name="Divider" type="Label" parent="PauseMenu/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.5, 0.3, 1)
theme_override_font_sizes/font_size = 14
text = "──────────────────────────────────"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="PauseMenu/VBoxContainer"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.98, 0.85, 1)
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("StyleBoxFlat_pause_n")
