; ── SIGNAL CONNECTIONS ───────────────────────────────────────────────────────
; These wire each button's "pressed" signal (and slider/toggle signals) to the
; matching function in main_menu.gd. "to" = "." means the root node (MainMenu).

[connection signal="pressed" from="CanvasLayer/MainPanel/PlayButton" to="." method="_on_play_pressed"]
[connection signal="pressed" from="CanvasLayer/MainPanel/LevelSelectButton" to="." method="_on_level_select_pressed"]
[connection signal="pressed" from="CanvasLayer/MainPanel/HowToPlayButton" to="." method="_on_how_to_play_pressed"]
[connection signal="pressed" from="CanvasLayer/MainPanel/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="CanvasLayer/MainPanel/QuitButton" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="CanvasLayer/HowToPlayPanel/VBoxContainer/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="CanvasLayer/SettingsPanel/VBoxContainer/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="CanvasLayer/LevelSelectPanel/VBoxContainer/Level1Button" to="." method="_on_level_pressed" binds=[0]]
[connection signal="pressed" from="CanvasLayer/LevelSelectPanel/VBoxContainer/Level2Button" to="." method="_on_level_pressed" binds=[1]]
[connection signal="pressed" from="CanvasLayer/LevelSelectPanel/VBoxContainer/Level3Button" to="." method="_on_level_pressed" binds=[2]]
[connection signal="pressed" from="CanvasLayer/LevelSelectPanel/VBoxContainer/Level4Button" to="." method="_on_level_pressed" binds=[3]]
[connection signal="pressed" from="CanvasLayer/LevelSelectPanel/VBoxContainer/Level5Button" to="." method="_on_level_pressed" binds=[4]]
[connection signal="pressed" from="CanvasLayer/LevelSelectPanel/VBoxContainer/BackButton" to="." method="_on_back_pressed"]
[connection signal="value_changed" from="CanvasLayer/SettingsPanel/VBoxContainer/MusicSlider" to="." method="_on_music_slider_changed"]
[connection signal="value_changed" from="CanvasLayer/SettingsPanel/VBoxContainer/AmbientSlider" to="." method="_on_ambient_slider_changed"]
[connection signal="value_changed" from="CanvasLayer/SettingsPanel/VBoxContainer/SFXSlider" to="." method="_on_sfx_slider_changed"]
[connection signal="value_changed" from="CanvasLayer/SettingsPanel/VBoxContainer/MouseSensitivitySlider" to="." method="_on_camera_setting_changed"]
[connection signal="value_changed" from="CanvasLayer/SettingsPanel/VBoxContainer/ControllerSensitivitySlider" to="." method="_on_camera_setting_changed"]
