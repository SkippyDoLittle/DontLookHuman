; ── BUTTON STYLE BOXES ──────────────────────────────────────────────────────
; StyleBoxFlat defines the visual appearance of a button in each state.
; Three states: normal (idle), hover (mouse over), pressed (clicked).

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_normal"]
bg_color = Color(0.06, 0.13, 0.06, 0.88)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.22, 0.52, 0.22, 1.0)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_hover"]
bg_color = Color(0.11, 0.24, 0.11, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.70, 0.35, 1.0)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_pressed"]
bg_color = Color(0.03, 0.07, 0.03, 1.0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.18, 0.40, 0.18, 1.0)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0

; ── SCENE TREE ───────────────────────────────────────────────────────────────

[node name="MainMenu" type="Node"]
script = ExtResource("1_mainmenu")

[node name="CanvasLayer" type="CanvasLayer" parent="." unique_id=3001000001]
layer = 5

; Full-screen dark background
[node name="Background" type="ColorRect" parent="CanvasLayer" unique_id=3001000002]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.03, 0.06, 0.03, 1.0)

; ── MAIN PANEL ───────────────────────────────────────────────────────────────
; A VBoxContainer centered on screen holding the title labels and nav buttons.
; anchors_preset=8 = CENTER preset (anchor point at screen centre).
; offsets push the container 170px left/right and 200px up/down from centre.

[node name="MainPanel" type="VBoxContainer" parent="CanvasLayer" unique_id=3001000003]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -170.0
offset_top = -205.0
offset_right = 170.0
offset_bottom = 205.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="TitleLabel" type="Label" parent="CanvasLayer/MainPanel" unique_id=3001000004]
theme_override_font_sizes/font_size = 42
theme_override_colors/font_color = Color(0.75, 0.95, 0.75, 1.0)
text = "Don't Look Human"
horizontal_alignment = 1

